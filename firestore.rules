rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function membershipDocBelongsToCaller() {
      return isSignedIn() &&
        (
          request.resource.data.uid == request.auth.uid ||
          resource.data.uid == request.auth.uid
        );
    }

    function organizationCreatorId(organizationId) {
      return get(/databases/$(database)/documents/organizations/$(organizationId)).data.createdBy;
    }

    function membershipDocId(organizationId) {
      return request.auth.uid + "__" + organizationId;
    }

    function isActiveOrganizationMember(organizationId) {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/organization_memberships/$(membershipDocId(organizationId))) &&
        get(/databases/$(database)/documents/organization_memberships/$(membershipDocId(organizationId))).data.status == "active";
    }

    function isMembershipOwnerCreate() {
      return isSignedIn() &&
        request.resource.data.uid == request.auth.uid &&
        request.resource.data.organizationId is string &&
        request.resource.data.organizationId.size() > 0;
    }

    function isMembershipOwnerUpdate() {
      return membershipDocBelongsToCaller() &&
        request.resource.data.uid == resource.data.uid &&
        request.resource.data.organizationId == resource.data.organizationId &&
        request.resource.data.status == resource.data.status &&
        request.resource.data.publicAlias == resource.data.publicAlias &&
        request.resource.data.requestedAt == resource.data.requestedAt &&
        request.resource.data.approvedBy == resource.data.approvedBy &&
        request.resource.data.approvedAt == resource.data.approvedAt;
    }

    function isMembershipApprover() {
      return isSignedIn() &&
        resource.data.organizationId is string &&
        organizationCreatorId(resource.data.organizationId) == request.auth.uid;
    }

    function isMembershipApprovalUpdate() {
      return isMembershipApprover() &&
        request.resource.data.uid == resource.data.uid &&
        request.resource.data.organizationId == resource.data.organizationId &&
        request.resource.data.publicAlias == resource.data.publicAlias &&
        request.resource.data.requestedAt == resource.data.requestedAt &&
        (
          request.resource.data.status == "active" ||
          request.resource.data.status == "suspended"
        );
    }

    match /users/{uid} {
      allow read, create, update: if isOwner(uid);
    }

    match /organizations/{organizationId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() &&
        request.resource.data.createdBy == request.auth.uid &&
        request.resource.data.internalName is string &&
        request.resource.data.internalName.size() > 0;
      allow update: if false;
      allow delete: if false;
    }

    match /organization_memberships/{membershipId} {
      allow read: if isSignedIn();
      allow create: if isMembershipOwnerCreate() &&
        (
          request.resource.data.status == "pending_approval" ||
          (
            request.resource.data.status == "active" &&
            organizationCreatorId(request.resource.data.organizationId) == request.auth.uid
          )
        );
      allow update: if isMembershipOwnerUpdate() || isMembershipApprovalUpdate();
      allow delete: if false;
    }

    match /libraries/{libraryId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn() &&
        request.resource.data.ownerId is string &&
        request.resource.data.ownerId.size() > 0;
      allow delete: if false;
    }

    match /library_cards/{cardId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn() &&
        request.resource.data.libraryId is string &&
        request.resource.data.libraryId.size() > 0;
      allow delete: if false;
    }

    match /published_cards/{cardId} {
      allow read: if true;
      allow create, update: if isSignedIn();
      allow delete: if false;
    }

    match /bookmarks/{bookmarkId} {
      allow read: if isSignedIn() && resource.data.uid == request.auth.uid;
      allow create, update: if isSignedIn() &&
        request.resource.data.uid == request.auth.uid;
      allow delete: if isSignedIn() && resource.data.uid == request.auth.uid;
    }

    match /hospitals/{hospitalId} {
      allow read: if true;
      allow create: if isSignedIn() && request.resource.data.addedBy == request.auth.uid;
      allow update, delete: if false;
    }

    match /surgeons/{surgeonId} {
      allow read: if true;
      allow create: if isSignedIn() && request.resource.data.addedBy == request.auth.uid;
      allow update, delete: if false;
    }

    match /card_checklists/{docId} {
      allow read, create, update: if isSignedIn() &&
        (
          request.resource.data.updatedBy == request.auth.uid ||
          resource.data.updatedBy == request.auth.uid
        );
      allow delete: if false;
    }

    match /card_custom_sections/{docId} {
      allow read, create, update: if isSignedIn() &&
        (
          request.resource.data.updatedBy == request.auth.uid ||
          resource.data.updatedBy == request.auth.uid
        );
      allow delete: if false;
    }

    match /collection_runs/{runId} {
      allow read, create: if isSignedIn() &&
        (
          request.resource.data.uid == request.auth.uid ||
          resource.data.uid == request.auth.uid
        );
      allow update, delete: if false;
    }

    match /admin_content/{docId} {
      allow read: if true;
      allow write: if false;
    }

    match /comms_threads/{threadId} {
      // Check uid in memberUids first (O(1), no extra reads) — covers DM threads.
      // Fall back to org membership check only when memberUids doesn't apply (org-wide threads).
      allow read: if isSignedIn() && (
        request.auth.uid in resource.data.memberUids ||
        (resource.data.organizationId is string &&
          resource.data.organizationId.size() > 0 &&
          isActiveOrganizationMember(resource.data.organizationId))
      );
      allow create: if isSignedIn() && (
        request.auth.uid in request.resource.data.memberUids ||
        (
          request.resource.data.organizationId is string &&
          request.resource.data.organizationId.size() > 0 &&
          isActiveOrganizationMember(request.resource.data.organizationId)
        )
      );
      allow update: if isSignedIn() && (
        request.auth.uid in resource.data.memberUids ||
        (resource.data.organizationId is string &&
          resource.data.organizationId.size() > 0 &&
          isActiveOrganizationMember(resource.data.organizationId))
      );
      allow delete: if false;
    }

    match /comms_messages/{messageId} {
      // Check uid in memberUids first (O(1)) — covers DMs.
      // uid == resource.data.uid lets senders always read their own messages.
      // Org membership check last (2 extra reads) — covers org-wide channel messages.
      // Removed isThreadMember (was 2 more reads on top, redundant with memberUids).
      allow read: if isSignedIn() && (
        request.auth.uid in resource.data.memberUids ||
        request.auth.uid == resource.data.uid ||
        (resource.data.organizationId is string &&
          resource.data.organizationId.size() > 0 &&
          isActiveOrganizationMember(resource.data.organizationId))
      );
      allow create: if isSignedIn() &&
        request.resource.data.uid == request.auth.uid && (
          request.auth.uid in request.resource.data.memberUids ||
          (
            request.resource.data.organizationId is string &&
            request.resource.data.organizationId.size() > 0 &&
            isActiveOrganizationMember(request.resource.data.organizationId)
          )
        );
      allow update, delete: if false;
    }

    match /comms_presence/{presenceId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn() &&
        request.resource.data.uid == request.auth.uid;
      allow delete: if false;
    }

    match /comms_calls/{callId} {
      allow get: if isSignedIn() && (
        resource.data.callerUid == request.auth.uid ||
        resource.data.calleeUid == request.auth.uid
      );
      allow list: if isSignedIn();
      allow create: if isSignedIn() &&
        request.resource.data.callerUid == request.auth.uid &&
        request.resource.data.organizationId is string;
      allow update: if isSignedIn() && (
        resource.data.callerUid == request.auth.uid ||
        resource.data.calleeUid == request.auth.uid
      );
      allow delete: if false;

      match /caller_candidates/{candidateId} {
        allow read, create: if isSignedIn();
        allow update, delete: if false;
      }
      match /callee_candidates/{candidateId} {
        allow read, create: if isSignedIn();
        allow update, delete: if false;
      }
    }

    match /comms_reads/{readId} {
      allow get: if isSignedIn() && resource.data.uid == request.auth.uid;
      allow list: if isSignedIn();
      allow create, update: if isSignedIn() &&
        request.resource.data.uid == request.auth.uid &&
        request.resource.data.organizationId is string &&
        request.resource.data.organizationId.size() > 0;
      allow delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
