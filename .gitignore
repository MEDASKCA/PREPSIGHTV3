# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

.vercel

# local agent/worktree artifacts
.claude/worktrees/
chrome-headless/
chrome-headless-2/

# local dev logs and scratch files
local-start*.log
local-start*.err.log
devtools-log.txt
headless-dom.html

# generated Python/cache artifacts
__pycache__/
*.pyc

# bulk sourcing/export artifacts not needed for app runtime
PrepSight_Fixed_Data_Inventory_sourced_batch*.xlsx
PrepSight_Fixed_Data_Inventory_import_test.xlsx

.vercel
